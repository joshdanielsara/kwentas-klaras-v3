generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "darwin", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  firebaseId String?   @unique @map("firebase_id")
  firstName  String?   @map("first_name")
  lastName   String?   @map("last_name")
  username   String?   @unique
  email      String?   @unique
  role       String    @default("staffs")
  department String?
  status     String?   @default("Active")
  joined     DateTime?
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([department])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Service {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("services")
}

model Department {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("departments")
}

model Location {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("locations")
}

model Remark {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("remarks")
}

model Project {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  implementingUnit String?   @map("implementing_unit")
  location         String?
  appropriation    Float
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  year             Int
  services         String
  remarks          String?
  code             String?
  latitude         Float?
  longitude        Float?
  createdAt        DateTime? @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  @@index([name])
  @@index([implementingUnit])
  @@index([location])
  @@index([year])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectActivity {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String    @map("project_id") @db.ObjectId
  action            String
  description       String
  userId            String?   @map("user_id") @db.ObjectId
  /// user | system | import | unknown
  actorType         String?   @map("actor_type")
  actorId           String?   @map("actor_id")
  /// Role label/slug snapshot at write time
  actorRoleSnapshot String?   @map("actor_role_snapshot")
  /// app | import | system
  source            String?
  /// Canonicalization format for integrity_hash (1 = legacy, 2 = actor-bound)
  canonVersion      Int?      @map("canon_version")
  metadata          String?
  integrityHash     String?   @map("integrity_hash")
  batchId           String?   @map("batch_id") @db.ObjectId
  merkleIndex       Int?      @map("merkle_index")
  createdAt         DateTime? @default(now()) @map("created_at")

  @@index([projectId])
  @@index([createdAt])
  @@index([batchId])
  @@index([integrityHash])
  @@map("project_activities")
}

/// Separate approval record for sensitive money actions (actor binding).
model IntegrityApproval {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String    @map("project_id") @db.ObjectId
  /// budget | obligation | disbursement
  resourceType      String    @map("resource_type")
  resourceId        String    @map("resource_id") @db.ObjectId
  requestId         String?   @map("request_id")
  /// pending | approved | rejected
  status            String    @default("pending")
  actorType         String?   @map("actor_type")
  actorId           String?   @map("actor_id")
  actorRoleSnapshot String?   @map("actor_role_snapshot")
  note              String?
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([resourceType, resourceId])
  @@index([status])
  @@map("integrity_approvals")
}

model AuditIntegrityBatch {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  merkleRoot        String    @map("merkle_root")
  otsProof          String?   @map("ots_proof")
  status            String    @default("pending")
  leafCount         Int       @default(0) @map("leaf_count")
  /// JSON map of projectId -> SHA-256 of canonical project master data
  projectDataHashes String?   @map("project_data_hashes")
  /// JSON map of budgets / obligations / disbursements -> hash + snapshot
  financialDataHashes String? @map("financial_data_hashes")
  sealedAt          DateTime? @map("sealed_at")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @updatedAt @map("updated_at")

  @@index([status])
  @@index([merkleRoot])
  @@index([createdAt])
  @@map("audit_integrity_batches")
}

model AdditionalBudget {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String    @map("project_id") @db.ObjectId
  amount       Float
  reason       String
  approvedBy   String?   @map("approved_by")
  approvedDate DateTime? @map("approved_date")
  approvalId   String?   @map("approval_id") @db.ObjectId
  status       String    @default("pending")
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([approvalId])
  @@map("additional_budgets")
}

model Obligation {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String    @map("project_id") @db.ObjectId
  amount       Float
  reason       String
  payee        String
  approvedBy   String?   @map("approved_by")
  approvedDate DateTime? @map("approved_date")
  approvalId   String?   @map("approval_id") @db.ObjectId
  status       String    @default("pending")
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([approvalId])
  @@map("obligations")
}

model Disbursement {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String    @map("project_id") @db.ObjectId
  amount       Float
  reason       String
  payee        String
  approvedBy   String?   @map("approved_by")
  approvedDate DateTime? @map("approved_date")
  approvalId   String?   @map("approval_id") @db.ObjectId
  status       String    @default("pending")
  createdAt    DateTime? @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([approvalId])
  @@map("disbursements")
}

model Role {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  slug        String    @unique
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  @@index([isSystem])
  @@map("roles")
}

model Permission {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  key         String    @unique
  action      String
  subject     String
  label       String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  @@index([action])
  @@index([subject])
  @@index([isSystem])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String    @map("role_id") @db.ObjectId
  permissionId String    @map("permission_id") @db.ObjectId
  createdAt    DateTime? @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AppSetting {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  key       String    @unique
  value     String
  updatedAt DateTime? @updatedAt @map("updated_at")
  createdAt DateTime? @default(now()) @map("created_at")

  @@map("app_settings")
}

